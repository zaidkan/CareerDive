# Local development only. No cloud credentials are needed for in-memory mode.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_SERVER_URL=http://localhost:3001
# Optional local DB. SQL migrations require Supabase auth schema or test fixture.
DATABASE_URL=
# Server verification uses only public Supabase API credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Browser public build-time credentials. Never put DATABASE_URL or service-role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public canonical origin, passed to Vite by its config.
SITE_ORIGIN=http://localhost:5173
BUILD_SHA=unknown
VITE_LAUNCH_ANALYTICS_ENABLED=false
INSTITUTIONAL_DEPLOYMENT_ENABLED=false
