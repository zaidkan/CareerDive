{
  "mcpServers": {
    "project-memory": {
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "neo4j-agent-memory[mcp,sentence-transformers]",
        "mcp",
        "serve",
        "--uri",
        "bolt://localhost:7687",
        "--user",
        "neo4j",
        "--database",
        "neo4j",
        "--profile",
        "extended",
        "--session-strategy",
        "persistent",
        "--user-id",
        "career-expo",
        "--no-auto-preferences",
        "--embedding",
        "BAAI/bge-small-en-v1.5"
      ],
      "env": {
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}"
      },
      "disabled": false
    }
  }
}