FROM node:24.14.0-alpine AS runtime
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
# Keep the workspace graph complete; runtime imports source exports via tsx.
COPY packages packages
COPY apps/server apps/server
COPY content content
RUN pnpm install --frozen-lockfile --filter @sim/server...
RUN node node_modules/typescript/bin/tsc -p apps/server/tsconfig.json
ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "--import", "tsx", "apps/server/src/main.ts"]
