{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "project-memory": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/uvx",
        "neo4j-agent-memory[mcp,sentence-transformers]",
        "mcp",
        "serve",
        "--uri",
        "bolt://localhost:7687",
        "--user",
        "neo4j",
        "--database",
        "neo4j",
        "--profile",
        "extended",
        "--session-strategy",
        "persistent",
        "--user-id",
        "career-expo",
        "--no-auto-preferences",
        "--embedding",
        "BAAI/bge-small-en-v1.5"
      ],
      "environment": {
        "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}
