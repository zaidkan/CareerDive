#!/usr/bin/env bash
#
# oc-worker — Career-Expo ephemeral OpenCode free-model worker dispatcher.
#
# Purpose
#   Dispatch a bounded task to ONE approved $0 OpenCode free model as an
#   ephemeral headless worker (clean context per task, no persistent TUI).
#   Kiro selects the DAG task + a task_class; the script resolves the model via
#   the routing matrix (muse13 > muse12 > big-pickle > nemotron style, per
#   class) with independent cooldown tracking, or the user forces --model.
#
# Model priority update (2026-09-19): Muse Spark 1.3 and 1.2 are TWO distinct
#   routable models. When Muse is preferred, try 1.3 then 1.2 before the rest.
#   They have independent availability / rate limits / cooldowns / telemetry.
#
# Slots (logical name -> verified $0 opencode id). Discovered via `opencode
#   models` + ~/.cache/opencode/models.json on 2026-09-19 (all in=0 out=0):
#     muse13     -> opencode/muse-spark-1.3-contributor-free   (effort variants)
#     muse12     -> opencode/muse-spark-1.2-contributor-free   (effort variants)
#     pickle1    -> opencode/big-pickle                         (no variants)
#     nemotron1  -> opencode/nemotron-3-ultra-free              (no variants)
#   NOTE: opencode/muse-spark-1.3 and opencode/muse-spark-1.2 (NO
#   "-contributor-free") are PAID (in=1.25). They are NOT allow-listed. The
#   --model muse13/muse12 aliases resolve to the FREE contributor ids only.
#   (union-alpha was removed upstream and is no longer referenced.)
#
# HARD COST RULE (no paid fallback, ever, without explicit human authorization)
#   Only the four allow-listed $0 ids below may be dispatched. Any other id is
#   REFUSED. This script NEVER silently substitutes a paid/Zen model. If a free
#   model is unavailable/rate-limited it reports throttled, marks a cooldown,
#   and follows the APPROVED free fallback chain only.
#
# Reasoning variants
#   muse13 + muse12 : effort = [minimal low medium high xhigh] (default xhigh).
#   pickle1, nemotron1 : no discrete effort tiers; --effort is ignored.
#
# Usage
#   scripts/oc-worker slots
#   scripts/oc-worker models                        # verify allow-listed ids are $0
#   scripts/oc-worker route --class <task_class>    # print resolved fallback chain (respects cooldowns)
#   scripts/oc-worker cooldowns                      # show current cooldown state
#   scripts/oc-worker warm    [--dir <path>]
#   scripts/oc-worker run  ( --class <task_class> | --model <muse13|muse12|big-pickle|nemotron> ) \
#                          --task <id> --reason "<why>" \
#                          [--class-tag <implementation|tests|refactor|debug|investigation>] \
#                          [--dir <path>] [--effort <minimal|low|medium|high|xhigh>] \
#                          (--prompt "<text>" | --spec <file>)
#
# Notes
#   - No secret is read or printed. NEO4J_PASSWORD reaches the MCP via
#     opencode.json {env:NEO4J_PASSWORD} interpolation only.
#   - Telemetry -> .orca-opencode/route.log (JSONL). Cooldowns ->
#     .orca-opencode/cooldown/<slot>. Rate-limit != quality failure.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OC_BIN="${OPENCODE_BIN:-opencode}"
LOG_DIR="$REPO_ROOT/.orca-opencode"
ROUTE_LOG="$LOG_DIR/route.log"
COOLDOWN_DIR="$LOG_DIR/cooldown"
MODELS_CACHE="${OPENCODE_MODELS_CACHE:-$HOME/.cache/opencode/models.json}"
MAX_RUN_SECONDS="${OC_MAX_RUN_SECONDS:-900}"
COOLDOWN_SECONDS="${OC_COOLDOWN_SECONDS:-900}"   # 15 min default after a rate-limit
mkdir -p "$LOG_DIR" "$COOLDOWN_DIR"

# --- Approved $0 model allow-list (slot -> model id). NO paid models. ---
slot_model() {
  case "$1" in
    muse13)    echo "opencode/muse-spark-1.3-contributor-free";;
    muse12)    echo "opencode/muse-spark-1.2-contributor-free";;
    pickle1)   echo "opencode/big-pickle";;
    nemotron1) echo "opencode/nemotron-3-ultra-free";;
    *) return 1;;
  esac
}
# User-facing --model aliases -> internal slot (free ids only).
model_alias_to_slot() {
  case "$1" in
    muse13) echo muse13;;
    muse12) echo muse12;;
    big-pickle|pickle|pickle1) echo pickle1;;
    nemotron|nemotron1) echo nemotron1;;
    *) return 1;;
  esac
}
slot_supports_variant() { [ "$1" = "muse13" ] || [ "$1" = "muse12" ]; }
is_allowlisted() {
  case "$1" in
    opencode/muse-spark-1.3-contributor-free|opencode/muse-spark-1.2-contributor-free|opencode/big-pickle|opencode/nemotron-3-ultra-free) return 0;;
    *) return 1;;
  esac
}

# --- Routing matrix: task_class -> ordered slot preference (space-separated) ---
# Muse-preferred classes lead with muse13 muse12; backend/analytic lead with
# nemotron/pickle. muse13 always precedes muse12 (never interchangeable).
route_chain() {
  case "$1" in
    ui_design|frontend_ux|game_feel|content_ux) echo "muse13 muse12 pickle1 nemotron1";;
    repo_implementation)                        echo "pickle1 muse13 muse12 nemotron1";;
    backend_runtime|integration|repo_exploration|debugging) echo "pickle1 nemotron1 muse13 muse12";;
    architecture|constraint_heavy|test_contract|review|verification) echo "nemotron1 pickle1 muse13 muse12";;
    large_context)                              echo "nemotron1 muse13 muse12 pickle1";;
    *) return 1;;
  esac
}

die() { echo "ERROR: $*" >&2; exit 1; }
iso_now() { date -u "+%Y-%m-%dT%H:%M:%SZ"; }
now_epoch() { date +%s; }

# --- Cooldown state (independent per slot; rate-limit only, not quality) ---
cooldown_active() { # slot -> 0 if cooling down
  local f="$COOLDOWN_DIR/$1"; [ -f "$f" ] || return 1
  local until; until="$(cat "$f" 2>/dev/null || echo 0)"
  [ "$(now_epoch)" -lt "$until" ]
}
mark_cooldown() { # slot
  echo "$(( $(now_epoch) + COOLDOWN_SECONDS ))" >"$COOLDOWN_DIR/$1"
  echo "[cooldown] $1 marked (rate-limit); skipped by routing for ${COOLDOWN_SECONDS}s. NOT a quality failure." >&2
}
clear_cooldown() { rm -f "$COOLDOWN_DIR/$1" 2>/dev/null || true; }

# Resolve the first non-cooldown slot in a class chain.
resolve_slot_for_class() {
  local chain; chain="$(route_chain "$1")" || die "unknown task_class '$1'"
  for s in $chain; do cooldown_active "$s" || { echo "$s"; return 0; }; done
  echo "[route] all slots in class '$1' are cooling down." >&2; return 1
}

cmd_slots() {
  printf '%-10s %-44s %-14s %s\n' SLOT MODEL_ID USAGE_POOL VARIANTS
  printf '%-10s %-44s %-14s %s\n' muse13    "$(slot_model muse13)"    opencode-free "minimal..xhigh"
  printf '%-10s %-44s %-14s %s\n' muse12    "$(slot_model muse12)"    opencode-free "minimal..xhigh"
  printf '%-10s %-44s %-14s %s\n' pickle1   "$(slot_model pickle1)"   opencode-free "none"
  printf '%-10s %-44s %-14s %s\n' nemotron1 "$(slot_model nemotron1)" opencode-free "none"
}

cmd_route() {
  [ "${1:-}" = "--class" ] || die "usage: route --class <task_class>"
  local chain; chain="$(route_chain "$2")" || die "unknown task_class '$2'"
  echo "class=$2 preference: $chain"
  local eff; eff="$(resolve_slot_for_class "$2" 2>/dev/null || echo "(all cooling down)")"
  echo "effective (after cooldowns): $eff"
}

cmd_cooldowns() {
  local any=0
  for s in muse13 muse12 pickle1 nemotron1; do
    if cooldown_active "$s"; then
      local until; until="$(cat "$COOLDOWN_DIR/$s")"
      echo "$s: cooling down for $(( until - $(now_epoch) ))s"; any=1
    fi
  done
  [ "$any" = 1 ] || echo "no active cooldowns"
}

cmd_models() {
  local ok=1 listed; listed="$("$OC_BIN" models 2>/dev/null || true)"
  for slot in muse13 muse12 pickle1 nemotron1; do
    local id short; id="$(slot_model "$slot")"; short="${id#opencode/}"
    if printf '%s\n' "$listed" | grep -qx "$id"; then
      local cost
      cost="$(MODELS_CACHE="$MODELS_CACHE" SHORT="$short" python3 - <<'PY'
import json,os
try:
    d=json.load(open(os.environ["MODELS_CACHE"]))
    m=d["opencode"]["models"][os.environ["SHORT"]]
    c=m.get("cost",{}); print(f'in={c.get("input")} out={c.get("output")}')
except Exception: print("cost=UNKNOWN")
PY
)"
      if printf '%s' "$cost" | grep -q "in=0 out=0"; then echo "OK   $slot -> $id  (\$0 verified)"
      else echo "WARN $slot -> $id  ($cost)  <-- NOT confirmed \$0; do NOT dispatch"; ok=0; fi
    else echo "FAIL $slot -> $id  (not in 'opencode models')"; ok=0; fi
  done
  [ "$ok" = 1 ] || { echo "One or more free models unverified. Refusing READY." >&2; return 2; }
}

cmd_warm() {
  local dir="$REPO_ROOT"; [ "${1:-}" = "--dir" ] && dir="$2"
  echo "[warm] priming project-memory MCP in $dir ..."
  ( "$OC_BIN" run --auto --dir "$dir" -m "$(slot_model muse13)" \
      "Use project-memory to search for subject __warmup_noop__ and reply WARM_OK." \
      >"$LOG_DIR/warm.out" 2>&1 & echo $! >"$LOG_DIR/.warm.pid" )
  local pid; pid="$(cat "$LOG_DIR/.warm.pid")"; local w=0
  while kill -0 "$pid" 2>/dev/null; do sleep 5; w=$((w+5)); [ "$w" -ge 240 ] && { kill "$pid" 2>/dev/null; break; }; done
  grep -q "WARM_OK\|returned" "$LOG_DIR/warm.out" 2>/dev/null && echo "[warm] warm." || echo "[warm] inconclusive; see $LOG_DIR/warm.out"
}

log_route() { # slot model task class_tag reason task_class result duration throttled note
  WORKER="$1" MODEL="$2" TASK="$3" TAG="$4" REASON="$5" TCLASS="$6" RESULT="$7" \
  DURATION="$8" THROTTLED="$9" NOTE="${10:-}" TS="$(iso_now)" python3 - >>"$ROUTE_LOG" <<'PY'
import json,os
print(json.dumps({
  "ts":os.environ["TS"],"worker":os.environ["WORKER"],"runner":"opencode",
  "model":os.environ["MODEL"],"task":os.environ["TASK"],"class_tag":os.environ["TAG"],
  "task_class":os.environ["TCLASS"],"reason":os.environ["REASON"],"cost_class":"free",
  "result":os.environ["RESULT"],"duration_s":int(os.environ["DURATION"]),
  "throttled":os.environ["THROTTLED"]=="1","note":os.environ["NOTE"],
}))
PY
}

# Dispatch one slot. Returns the run result code; sets RESULT_STR global.
dispatch_slot() {
  local slot="$1" task="$2" tag="$3" reason="$4" tclass="$5" dir="$6" effort="$7" prompt="$8"
  local model; model="$(slot_model "$slot")" || die "unknown slot '$slot'"
  is_allowlisted "$model" || die "refusing non-allow-listed model '$model' (no paid fallback)"

  local variant_args=()
  if slot_supports_variant "$slot"; then
    case "$effort" in minimal|low|medium|high|xhigh) variant_args=(--variant "$effort");;
      *) die "invalid --effort '$effort'";; esac
  elif [ "$effort" != "xhigh" ]; then
    echo "[note] $slot has no reasoning variants; ignoring --effort $effort" >&2
  fi

  echo "ROUTE dispatch worker=$slot model=${model#opencode/} task=$task task_class=${tclass:-forced} cost_class=free ${variant_args[*]:-}"
  local out; out="$LOG_DIR/run-$slot-$task-$(date +%Y%m%d-%H%M%S).out"
  local start; start="$(now_epoch)"
  ( "$OC_BIN" run --auto --dir "$dir" -m "$model" ${variant_args[@]+"${variant_args[@]}"} "$prompt" >"$out" 2>&1 & echo $! >"$LOG_DIR/.run.pid" )
  local pid; pid="$(cat "$LOG_DIR/.run.pid")"; local w=0 timed_out=0
  while kill -0 "$pid" 2>/dev/null; do sleep 5; w=$((w+5)); if [ "$w" -ge "$MAX_RUN_SECONDS" ]; then kill "$pid" 2>/dev/null; timed_out=1; break; fi; done
  local dur=$(( $(now_epoch) - start )) throttled=0 result="success"

  if grep -qiE "rate.?limit|too many requests|429|quota|throttl" "$out"; then throttled=1; result="throttled"; fi
  if grep -qiE "connection closed|-32000" "$out"; then result="mcp_cold_start_error"; fi
  [ "$timed_out" = 1 ] && result="timeout"
  if grep -qiE "^Error:|\bError\b.*failed" "$out" && [ "$result" = "success" ]; then result="error"; fi
  # Paid-leak audit: only the four free ids may appear in a session header.
  if grep -qE "> build ·" "$out" && grep -E "> build ·" "$out" | grep -qvE "muse-spark-1.3-contributor-free|muse-spark-1.2-contributor-free|big-pickle|nemotron-3-ultra-free"; then
    result="PAID_MODEL_LEAK"; echo "!! ALERT: non-free model header in $out" >&2
  fi

  [ "$throttled" = 1 ] && mark_cooldown "$slot" || { [ "$result" = "success" ] && clear_cooldown "$slot"; }
  log_route "$slot" "$model" "$task" "$tag" "$reason" "$tclass" "$result" "$dur" "$throttled" "$out"
  echo "ROUTE result worker=$slot task=$task result=$result duration=${dur}s throttled=$throttled log=$out"
  echo "--- worker output (tail) ---"; grep -vE "^timestamp=" "$out" | tail -20
  RESULT_STR="$result"
  case "$result" in success) return 0;; throttled) return 3;; mcp_cold_start_error) return 4;; timeout) return 5;; PAID_MODEL_LEAK) return 42;; *) return 1;; esac
}

cmd_run() {
  local tclass="" force_model="" task="" tag="implementation" reason="" dir="$REPO_ROOT" \
        effort="xhigh" prompt="" spec=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --class) tclass="$2"; shift 2;;
      --model) force_model="$2"; shift 2;;
      --task) task="$2"; shift 2;;
      --class-tag) tag="$2"; shift 2;;
      --reason) reason="$2"; shift 2;;
      --dir) dir="$2"; shift 2;;
      --effort) effort="$2"; shift 2;;
      --prompt) prompt="$2"; shift 2;;
      --spec) spec="$2"; shift 2;;
      *) die "unknown arg: $1";;
    esac
  done
  [ -n "$task" ]   || die "--task <id> required"
  [ -n "$reason" ] || die "--reason required (telemetry)"
  if [ -z "$prompt" ] && [ -n "$spec" ]; then [ -f "$spec" ] || die "spec not found: $spec"; prompt="$(cat "$spec")"; fi
  [ -n "$prompt" ] || die "provide --prompt or --spec"
  [ -n "$tclass" ] || [ -n "$force_model" ] || die "provide --class <task_class> or --model <alias>"

  # Build the ordered slot attempt list.
  local attempt_slots=()
  if [ -n "$force_model" ]; then
    local s; s="$(model_alias_to_slot "$force_model")" || die "unknown --model '$force_model' (muse13|muse12|big-pickle|nemotron)"
    attempt_slots=("$s")   # forced: no auto-fallback across models
    echo "[route] forced model -> slot $s (no auto-fallback)"
  else
    for s in $(route_chain "$tclass" 2>/dev/null || die "unknown task_class '$tclass'"); do attempt_slots+=("$s"); done
  fi

  # Try slots in order, honoring cooldowns; on throttle, continue the chain
  # (muse13 -> muse12 before pickle for muse-preferred classes, by construction).
  local rc=1
  for s in "${attempt_slots[@]}"; do
    if cooldown_active "$s"; then echo "[route] skip $s (cooldown active)"; continue; fi
    dispatch_slot "$s" "$task" "$tag" "$reason" "$tclass" "$dir" "$effort" "$prompt" && { rc=0; break; }
    rc=$?
    if [ "$rc" = 3 ]; then echo "[route] $s throttled; trying next APPROVED free slot..." >&2; continue; fi
    break   # non-throttle failure: stop (do not burn other slots on a real error)
  done
  [ "$rc" = 0 ] || echo "[route] no approved free slot completed task=$task (last result=${RESULT_STR:-none}). Do NOT fall back to paid; ask user." >&2
  return "$rc"
}

sub="${1:-}"; shift || true
case "$sub" in
  slots) cmd_slots;;
  models) cmd_models;;
  route) cmd_route "$@";;
  cooldowns) cmd_cooldowns;;
  warm) cmd_warm "$@";;
  run) cmd_run "$@";;
  *)
    cat >&2 <<EOF
oc-worker — ephemeral OpenCode free-model dispatcher (muse13>muse12>pickle>nemotron; no paid fallback)
usage:
  scripts/oc-worker slots
  scripts/oc-worker models
  scripts/oc-worker route --class <task_class>
  scripts/oc-worker cooldowns
  scripts/oc-worker warm [--dir <path>]
  scripts/oc-worker run ( --class <task_class> | --model <muse13|muse12|big-pickle|nemotron> ) \\
     --task <id> --reason "<why>" [--class-tag <impl|tests|refactor|debug|investigation>] \\
     [--dir <path>] [--effort <minimal|low|medium|high|xhigh>] (--prompt "<text>" | --spec <file>)
task_class: ui_design frontend_ux game_feel content_ux repo_implementation
            backend_runtime integration repo_exploration debugging architecture
            constraint_heavy test_contract review verification large_context
EOF
    exit 64;;
esac
