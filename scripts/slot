#!/usr/bin/env bash
#
# slot — Career-Expo model-terminal resolver (account + model tier).
#
# Model
#   Each Codex ACCOUNT (zk, hamza) runs up to 3 model terminals, named EXACTLY
#   by the manual Orca tab title (Codex cannot overwrite the tab-level title):
#       terrazk  solzk  astrazk        (account zk)
#       terrahamza  solhamza  astrahamza   (account hamza)
#   Tab name = <model><account>, model in {terra, sol, astra}, account in {zk, hamza}.
#   terra=Terra High, sol=Sol High, astra=Astra Low (default; Med/High only on
#   explicit user change for one task, then back to Low).
#
#   Identity comes ONLY from the manual tab-level title
#   (terminal list --include-visual-layouts -> visualLayouts[].root.tabs[].title,
#   joined to a live Codex terminal by tabId). No markers, no scrollback, no
#   state file, no persisted handles.
#
#   ACCOUNT-LEVEL CONCURRENCY: the 3 terminals of an account share ONE usage
#   pool. Enforce ONE ROOT TASK PER ACCOUNT (not per terminal). `account-status`
#   reports, per account, whether any of its terminals is backing an active root
#   task (BUSY) so Kiro does not double-spend an account.
#
# Usage
#   scripts/slot list                      # all model terminals (JSON)
#   scripts/slot resolve <model> <account> # one terminal handle+state (JSON)
#       e.g. scripts/slot resolve terra zk   -> resolves tab 'terrazk'
#   scripts/slot account-status            # per-account BUSY/free + active dispatch (JSON)
#   scripts/slot capacity                  # integer: accounts with >=1 live terminal and not busy
#
#   models: terra sol astra    accounts: zk hamza

set -euo pipefail

ORCA_BIN="${ORCA_CLI_COMMAND:-orca}"
CAREER_EXPO_WORKTREE="${CAREER_EXPO_WORKTREE:-id:e4e8bc75-131b-4baf-a2f1-aa6fa411f9c8::/Users/zaid/orca/Career-Expo}"
RUN_ID="${CAREER_EXPO_RUN:-}"

MODELS=(terra sol astra)
ACCOUNTS=(zk hamza)

is_model()   { case "$1" in terra|sol|astra) return 0;; *) return 1;; esac; }
is_account() { case "$1" in zk|hamza) return 0;; *) return 1;; esac; }

# Emit resolved model-terminal table as JSON.
# rows: {name, model, account, handle, state}  where state = AVAILABLE|UNAVAILABLE|AMBIGUOUS
resolve_all() {
  ORCA_BIN="$ORCA_BIN" WORKTREE="$CAREER_EXPO_WORKTREE" python3 - <<'PY'
import json, os, subprocess

orca = os.environ["ORCA_BIN"]
worktree = os.environ["WORKTREE"]
models = ["terra", "sol", "astra"]
accounts = ["zk", "hamza"]
names = [m + a for a in accounts for m in models]  # terrazk, solzk, ...

listing = subprocess.run(
    [orca, "terminal", "list", "--worktree", worktree,
     "--include-visual-layouts", "--json"],
    capture_output=True, text=True, check=True,
).stdout
res = json.loads(listing).get("result", {})

live_by_tab = {}
for t in res.get("terminals", []):
    if t.get("agentIdentity") != "codex" or not t.get("connected"):
        continue
    live_by_tab.setdefault(t.get("tabId"), t.get("handle"))

def walk(node, out):
    if not isinstance(node, dict):
        return
    for t in node.get("tabs", []) or []:
        out.append((t.get("tabId"), t.get("title")))
        walk(t, out)
    p = node.get("panes")
    if isinstance(p, dict):
        walk(p, out)

tabs = []
for lay in res.get("visualLayouts", []):
    walk(lay.get("root", {}), tabs)

def parse(name):
    """exact <model><account> -> (model, account) or None."""
    for a in accounts:
        for m in models:
            if name == m + a:
                return (m, a)
    return None

# name -> list of handles (exact match)
by_name = {n: [] for n in names}
for tab_id, title in tabs:
    h = live_by_tab.get(tab_id)
    if h is None or not title:
        continue
    if title in by_name:
        by_name[title].append(h)

rows = []
for a in accounts:
    for m in models:
        n = m + a
        hs = by_name[n]
        if len(hs) == 0:
            rows.append({"name": n, "model": m, "account": a, "handle": None, "state": "UNAVAILABLE"})
        elif len(hs) == 1:
            rows.append({"name": n, "model": m, "account": a, "handle": hs[0], "state": "AVAILABLE"})
        else:
            rows.append({"name": n, "model": m, "account": a, "handle": hs, "state": "AMBIGUOUS"})

print(json.dumps({"terminals": rows}, indent=2))
PY
}

# Per-account status incl. one-root-task-per-account lock (needs run id).
account_status() {
  ORCA_BIN="$ORCA_BIN" RUN_ID="$RUN_ID" WORKTREE="$CAREER_EXPO_WORKTREE" python3 - <<'PY'
import json, os, subprocess

orca = os.environ["ORCA_BIN"]
run_id = os.environ.get("RUN_ID", "")
worktree = os.environ["WORKTREE"]
models = ["terra", "sol", "astra"]; accounts = ["zk", "hamza"]

# reuse resolve_all logic inline
listing = subprocess.run([orca,"terminal","list","--worktree",worktree,"--include-visual-layouts","--json"],
                         capture_output=True,text=True,check=True).stdout
res = json.loads(listing).get("result", {})
live_by_tab = {}
for t in res.get("terminals", []):
    if t.get("agentIdentity")=="codex" and t.get("connected"):
        live_by_tab.setdefault(t.get("tabId"), t.get("handle"))
def walk(node,out):
    if not isinstance(node,dict): return
    for t in node.get("tabs",[]) or []: out.append((t.get("tabId"),t.get("title"))); walk(t,out)
    p=node.get("panes"); 
    if isinstance(p,dict): walk(p,out)
tabs=[]
for lay in res.get("visualLayouts",[]): walk(lay.get("root",{}),tabs)
name_handle={}
for tid,title in tabs:
    h=live_by_tab.get(tid)
    if h and title and title in [m+a for a in accounts for m in models]:
        name_handle.setdefault(title,h)

# active root dispatches by terminal handle (best-effort; needs run)
active_handles=set()
if run_id:
    try:
        wl=subprocess.run([orca,"orchestration","worker-list","--run",run_id,"--json"],
                          capture_output=True,text=True,check=True).stdout
        d=json.loads(wl).get("result",{})
        act={"ready","running","dispatched","working"}
        for w in d.get("workers",[]):
            if str(w.get("workerState","")).lower() in act and w.get("agentTerminalHandle"):
                active_handles.add(w["agentTerminalHandle"])
    except Exception:
        pass

out=[]
for a in accounts:
    terms={}
    busy_by=None
    for m in models:
        n=m+a; h=name_handle.get(n)
        terms[n]={"handle":h,"live":bool(h)}
        if h and h in active_handles: busy_by=n
    live_any=any(t["live"] for t in terms.values())
    out.append({"account":a,"live":live_any,"busy": busy_by is not None,
                "busy_terminal":busy_by,"terminals":terms,
                "state":("BUSY" if busy_by else ("FREE" if live_any else "UNAVAILABLE"))})
print(json.dumps({"accounts":out,"run":run_id or None}, indent=2))
PY
}

cmd="${1:-}"; shift || true
case "$cmd" in
  list) resolve_all ;;
  resolve)
    model="${1:-}"; account="${2:-}"
    is_model "$model" && is_account "$account" || { echo "usage: slot resolve <terra|sol|astra> <zk|hamza>" >&2; exit 64; }
    resolve_all | python3 -c "import json,sys; d=json.load(sys.stdin); n=sys.argv[1]+sys.argv[2]; r=[x for x in d['terminals'] if x['name']==n][0]; print(json.dumps(r,indent=2))" "$model" "$account"
    ;;
  account-status) account_status ;;
  capacity)
    account_status | python3 -c "import json,sys; d=json.load(sys.stdin); print(sum(1 for a in d['accounts'] if a['state']=='FREE'))"
    ;;
  *)
    cat >&2 <<EOF
slot — Career-Expo model-terminal resolver (account + model tier)
usage:
  scripts/slot list                       all model terminals (JSON)
  scripts/slot resolve <model> <account>  one terminal (JSON)   e.g. resolve terra zk -> terrazk
  scripts/slot account-status             per-account BUSY/free (set CAREER_EXPO_RUN for lock check)
  scripts/slot capacity                   # of accounts live and not busy
  models: terra sol astra   accounts: zk hamza
EOF
    exit 64
    ;;
esac
