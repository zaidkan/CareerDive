#!/usr/bin/env bash
#
# slot — Career-Expo worker-slot availability helper.
#
# Purpose
#   Give the user one simple command to enable/disable a canonical Codex
#   subscription slot, and give Kiro one deterministic resolver for scheduling.
#
# Model (manual-tab-name only)
#   Logical slots (canonical names): hamza=CODEX-1, zk1=CODEX-2, zk2=CODEX-3.
#
#   Identity AND availability are derived ENTIRELY from the reliable manual
#   Orca tab name exposed at
#       terminal list --include-visual-layouts --json
#       -> result.visualLayouts[].root.tabs[].title   (joined by tabId)
#   Orca does NOT let Codex overwrite this tab-level title. The flat/process
#   `title` field IS overwritten by Codex and is never used here.
#
#   A live terminal belongs to a slot if its manual tab name begins with the
#   slot's canonical prefix (hamza / zk1 / zk2). It is ENABLED iff the manual
#   tab name EXACTLY equals the canonical name; any suffix (hamzaoff, hamza1,
#   hamza-anything) means DISABLED.
#
#   No ORCA_SLOT stream marker. No terminal scrollback read. No state file.
#   No terminal UUID is persisted anywhere. Handles are resolved dynamically
#   by joining the matching tab's tabId to its current live terminal.
#
# Prefix precedence note: zk1 and zk2 do not collide (distinct prefixes), and
# "hamza" does not prefix "zk*". A name is matched to at most one slot by exact
# canonical prefix.
#
# Usage
#   scripts/slot list                 # resolve + print every slot's state (JSON)
#   scripts/slot resolve <slot>       # resolve one slot (JSON)
#   scripts/slot on  <slot>           # enable  (rename manual tab -> <slot>)
#   scripts/slot off <slot>           # disable (rename manual tab -> <slot>off)
#   scripts/slot capacity             # print integer root-worker capacity
#
#   <slot> is one of: hamza | zk1 | zk2
#
# Notes
#   Requires Orca running. Uses the Orca CLI resolved from $ORCA_CLI_COMMAND,
#   else `orca`.

set -euo pipefail

ORCA_BIN="${ORCA_CLI_COMMAND:-orca}"
CAREER_EXPO_WORKTREE="${CAREER_EXPO_WORKTREE:-id:e4e8bc75-131b-4baf-a2f1-aa6fa411f9c8::/Users/zaid/orca/Career-Expo}"

CANONICAL_SLOTS=(hamza zk1 zk2)

is_canonical() {
  local s="$1"
  for c in "${CANONICAL_SLOTS[@]}"; do
    [[ "$s" == "$c" ]] && return 0
  done
  return 1
}

# Emit the resolved slot table as JSON on stdout.
# Each row: {slot, count, identity_handle, tab_name, enabled, state}
# Identity + availability come only from the manual tab-level title.
resolve_all() {
  ORCA_BIN="$ORCA_BIN" WORKTREE="$CAREER_EXPO_WORKTREE" python3 - <<'PY'
import json, os, subprocess

orca = os.environ["ORCA_BIN"]
worktree = os.environ["WORKTREE"]
canonical = ["hamza", "zk1", "zk2"]

listing = subprocess.run(
    [orca, "terminal", "list", "--worktree", worktree,
     "--include-visual-layouts", "--json"],
    capture_output=True, text=True, check=True,
).stdout
res = json.loads(listing).get("result", {})
terminals = res.get("terminals", [])
layouts = res.get("visualLayouts", [])

# Live-terminal set by tabId (a terminal must be present, connected, Codex).
live_by_tab = {}
for t in terminals:
    if t.get("agentIdentity") != "codex":
        continue
    if not t.get("connected"):
        continue
    live_by_tab.setdefault(t.get("tabId"), t.get("handle"))

# Manual tab-level titles (NOT the Codex-overwritten pane/flat title).
def walk_tabs(node, out):
    if not isinstance(node, dict):
        return
    for t in node.get("tabs", []) or []:
        out.append((t.get("tabId"), t.get("title")))
        walk_tabs(t, out)
    panes = node.get("panes")
    if isinstance(panes, dict):
        walk_tabs(panes, out)

tabs = []
for lay in layouts:
    walk_tabs(lay.get("root", {}), tabs)

def slot_for(name):
    """Return the canonical slot whose prefix matches this manual tab name, or None."""
    if not name:
        return None
    for c in canonical:
        if name == c or name.startswith(c):
            return c
    return None

# slot -> list of {handle, tab_name, enabled}
by_slot = {s: [] for s in canonical}
for tab_id, title in tabs:
    handle = live_by_tab.get(tab_id)
    if handle is None:
        continue  # tab has no live Codex terminal
    slot = slot_for(title)
    if slot is None:
        continue
    by_slot[slot].append({
        "handle": handle,
        "tab_name": title,
        "enabled": (title == slot),  # EXACT match required
    })

rows = []
capacity = 0
for slot in canonical:
    entries = by_slot[slot]
    count = len(entries)
    if count == 0:
        rows.append({"slot": slot, "count": 0, "identity_handle": None,
                     "tab_name": None, "enabled": False, "state": "UNAVAILABLE"})
        continue
    if count > 1:
        rows.append({"slot": slot, "count": count,
                     "identity_handle": [e["handle"] for e in entries],
                     "tab_name": [e["tab_name"] for e in entries],
                     "enabled": False, "state": "AMBIGUOUS"})
        continue
    e = entries[0]
    enabled = e["enabled"]
    # BUSY vs AVAILABLE (active root task) is decided by Kiro against
    # orchestration worker-list; this helper reports schedulable-eligibility.
    state = "AVAILABLE" if enabled else "UNAVAILABLE"
    if enabled:
        capacity += 1
    rows.append({"slot": slot, "count": 1, "identity_handle": e["handle"],
                 "tab_name": e["tab_name"], "enabled": enabled, "state": state})

print(json.dumps({"slots": rows, "capacity": capacity}, indent=2))
PY
}

# Resolve the current live handle for exactly one slot (any canonical-prefix
# tab, enabled or disabled). Prints the handle, or exits non-zero.
resolve_handle() {
  local want="$1"
  resolve_all | python3 -c '
import json, sys
want = sys.argv[1]
data = json.load(sys.stdin)
for r in data["slots"]:
    if r["slot"] == want:
        h = r["identity_handle"]
        if r["count"] == 1 and isinstance(h, str):
            print(h); sys.exit(0)
        if r["count"] == 0:
            sys.stderr.write("slot %s: no live Codex terminal whose manual tab name begins with %s\n" % (want, want)); sys.exit(2)
        sys.stderr.write("slot %s: AMBIGUOUS (%d terminals match the prefix)\n" % (want, r["count"])); sys.exit(3)
sys.stderr.write("unknown slot %s\n" % want); sys.exit(4)
' "$want"
}

cmd="${1:-}"; shift || true

case "$cmd" in
  list)
    resolve_all
    ;;
  resolve)
    slot="${1:-}"; is_canonical "$slot" || { echo "usage: slot resolve <hamza|zk1|zk2>" >&2; exit 64; }
    resolve_all | python3 -c "import json,sys; d=json.load(sys.stdin); r=[x for x in d['slots'] if x['slot']==sys.argv[1]][0]; print(json.dumps(r, indent=2))" "$slot"
    ;;
  capacity)
    resolve_all | python3 -c "import json,sys; print(json.load(sys.stdin)['capacity'])"
    ;;
  on)
    slot="${1:-}"; is_canonical "$slot" || { echo "usage: slot on <hamza|zk1|zk2>" >&2; exit 64; }
    handle="$(resolve_handle "$slot")"
    "$ORCA_BIN" terminal rename --terminal "$handle" --title "$slot" --json >/dev/null
    echo "slot $slot ENABLED (manual tab renamed to '$slot')"
    ;;
  off)
    slot="${1:-}"; is_canonical "$slot" || { echo "usage: slot off <hamza|zk1|zk2>" >&2; exit 64; }
    handle="$(resolve_handle "$slot")"
    "$ORCA_BIN" terminal rename --terminal "$handle" --title "${slot}off" --json >/dev/null
    echo "slot $slot DISABLED (manual tab renamed to '${slot}off')"
    ;;
  *)
    cat >&2 <<EOF
slot — Career-Expo worker-slot availability helper (manual-tab-name only)
usage:
  scripts/slot list             resolve and print all slot states (JSON)
  scripts/slot resolve <slot>   resolve one slot (JSON)
  scripts/slot on  <slot>       enable  (manual tab -> <slot>)
  scripts/slot off <slot>       disable (manual tab -> <slot>off)
  scripts/slot capacity         print integer root-worker capacity
  <slot> = hamza | zk1 | zk2
EOF
    exit 64
    ;;
esac
