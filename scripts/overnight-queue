#!/usr/bin/env bash
#
# overnight-queue — simple, reusable overnight worker queue for local Orca.
#
# Purpose
#   Before sleeping, queue genuinely-useful pre-staged work for a Codex slot
#   (hamza / zk1 / zk2). The job waits until ~1h after that account's 5h limit
#   reset (rolling-window buffer), then dispatches to the dynamically-resolved
#   terminal via `orca orchestration worker-start --terminal <handle>` ONLY if
#   the slot's canonical tab exists, is enabled, live, and not already running a
#   root task. If unavailable / usage not reset, it retries every 10 min for a
#   bounded window instead of failing permanently.
#
# Design principles
#   - Kiro/Orca remain the management layer; this is NOT another orchestrator.
#   - Reuses scripts/slot for identity+availability; NEVER persists a handle.
#   - Runs detached (nohup) so it does not need Kiro running overnight.
#   - Wraps the whole wait+retry window in `/usr/bin/caffeinate -imsu` so the
#     Mac stays awake for the entire window (assumes plugged in, lid open).
#   - One root task per subscription: refuses to dispatch if the resolved
#     terminal already backs an active root task in the given run.
#
# Usage
#   scripts/overnight-queue add   --slot <hamza|zk1|zk2> --run <run_id> \
#                                 --spec <path-to-spec-file> \
#                                 --reset "YYYY-MM-DD HH:MM" [--buffer-min 60] \
#                                 [--retry-min 10] [--window-min 120]
#   scripts/overnight-queue list
#   scripts/overnight-queue cancel <job_id|all>
#   scripts/overnight-queue logs <job_id>
#
# The 'run' subcommand is internal (invoked detached); do not call it directly.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ORCA_BIN="${ORCA_CLI_COMMAND:-orca}"
SLOT_BIN="$REPO_ROOT/scripts/slot"
WORKTREE_ID="${CAREER_EXPO_WORKTREE:-id:e4e8bc75-131b-4baf-a2f1-aa6fa411f9c8::/Users/zaid/orca/Career-Expo}"
QDIR="$REPO_ROOT/.orca-overnight"
mkdir -p "$QDIR"

now_epoch() { date +%s; }
human() { date -r "$1" "+%Y-%m-%d %H:%M:%S %Z" 2>/dev/null || date -d "@$1" "+%Y-%m-%d %H:%M:%S %Z"; }

# Parse "YYYY-MM-DD HH:MM" (local) to epoch on macOS/BSD date.
parse_local() {
  local s="$1"
  date -j -f "%Y-%m-%d %H:%M" "$s" +%s 2>/dev/null \
    || date -d "$s" +%s 2>/dev/null \
    || { echo "ERROR: cannot parse time '$s' (use 'YYYY-MM-DD HH:MM')" >&2; return 1; }
}

cmd_add() {
  local slot="" run_id="" spec="" reset="" buffer_min=60 retry_min=10 window_min=120
  while [ $# -gt 0 ]; do
    case "$1" in
      --slot) slot="$2"; shift 2;;
      --run) run_id="$2"; shift 2;;
      --spec) spec="$2"; shift 2;;
      --reset) reset="$2"; shift 2;;
      --buffer-min) buffer_min="$2"; shift 2;;
      --retry-min) retry_min="$2"; shift 2;;
      --window-min) window_min="$2"; shift 2;;
      *) echo "unknown arg $1" >&2; exit 64;;
    esac
  done
  case "$slot" in hamza|zk1|zk2) ;; *) echo "ERROR: --slot must be hamza|zk1|zk2" >&2; exit 64;; esac
  [ -n "$run_id" ] || { echo "ERROR: --run <run_id> required" >&2; exit 64; }
  [ -f "$spec" ]   || { echo "ERROR: --spec file not found: $spec" >&2; exit 64; }
  [ -n "$reset" ]  || { echo "ERROR: --reset 'YYYY-MM-DD HH:MM' required" >&2; exit 64; }

  local reset_epoch start_epoch
  reset_epoch="$(parse_local "$reset")" || exit 65
  start_epoch=$(( reset_epoch + buffer_min * 60 ))

  local job_id spec_copy
  job_id="$slot-$(date +%Y%m%d-%H%M%S)"
  spec_copy="$QDIR/$job_id.spec"
  cp "$spec" "$spec_copy"

  cat > "$QDIR/$job_id.job" <<EOF
JOB_ID=$job_id
SLOT=$slot
RUN_ID=$run_id
SPEC=$spec_copy
RESET_EPOCH=$reset_epoch
START_EPOCH=$start_epoch
RETRY_MIN=$retry_min
WINDOW_MIN=$window_min
CREATED=$(now_epoch)
EOF

  # Launch detached, caffeinated runner. caffeinate wraps the entire loop so the
  # Mac stays awake for the whole wait+retry window (not just job creation).
  nohup /usr/bin/caffeinate -imsu "$REPO_ROOT/scripts/overnight-queue" run "$job_id" \
    >"$QDIR/$job_id.log" 2>&1 &
  echo $! > "$QDIR/$job_id.pid"

  echo "Queued job $job_id"
  echo "  slot:        $slot"
  echo "  run:         $run_id"
  echo "  reset:       $(human "$reset_epoch")"
  echo "  dispatch at: $(human "$start_epoch")  (reset + ${buffer_min}m buffer)"
  echo "  retry:       every ${retry_min}m for up to ${window_min}m if slot unavailable"
  echo "  spec:        $spec_copy"
  echo "  runner pid:  $(cat "$QDIR/$job_id.pid")  (caffeinate active for full window)"
}

cmd_list() {
  shopt -s nullglob
  local any=0
  for j in "$QDIR"/*.job; do
    any=1
    # shellcheck disable=SC1090
    ( source "$j"
      local pid="?"; [ -f "$QDIR/$JOB_ID.pid" ] && pid="$(cat "$QDIR/$JOB_ID.pid")"
      local alive="dead"; kill -0 "$pid" 2>/dev/null && alive="alive"
      local status="pending"; [ -f "$QDIR/$JOB_ID.done" ] && status="$(cat "$QDIR/$JOB_ID.done")"
      echo "$JOB_ID | slot=$SLOT | dispatch_at=$(human "$START_EPOCH") | runner=$pid($alive) | status=$status"
    )
  done
  [ "$any" = 1 ] || echo "No overnight jobs queued."
}

cmd_cancel() {
  local target="${1:-}"; [ -n "$target" ] || { echo "usage: cancel <job_id|all>" >&2; exit 64; }
  shopt -s nullglob
  for j in "$QDIR"/*.job; do
    # shellcheck disable=SC1090
    source "$j"
    if [ "$target" = "all" ] || [ "$target" = "$JOB_ID" ]; then
      [ -f "$QDIR/$JOB_ID.pid" ] && kill "$(cat "$QDIR/$JOB_ID.pid")" 2>/dev/null || true
      echo "cancelled $JOB_ID (runner stopped; caffeinate released)"
      mv "$j" "$QDIR/$JOB_ID.cancelled" 2>/dev/null || true
    fi
  done
}

cmd_logs() {
  local id="${1:-}"; [ -n "$id" ] || { echo "usage: logs <job_id>" >&2; exit 64; }
  cat "$QDIR/$id.log" 2>/dev/null || echo "no log for $id"
}

# Internal: the detached, caffeinated wait+retry+dispatch loop.
cmd_run() {
  local job_id="${1:-}"; [ -n "$job_id" ] || { echo "run needs job_id" >&2; exit 64; }
  # shellcheck disable=SC1090
  source "$QDIR/$job_id.job"
  log() { echo "[$(date '+%F %T %Z')] $*"; }

  log "runner start for $JOB_ID slot=$SLOT run=$RUN_ID"
  log "sleeping until dispatch window: $(human "$START_EPOCH")"
  local nowe; nowe="$(now_epoch)"
  if [ "$START_EPOCH" -gt "$nowe" ]; then sleep $(( START_EPOCH - nowe )); fi

  local deadline=$(( START_EPOCH + WINDOW_MIN * 60 ))
  while [ "$(now_epoch)" -le "$deadline" ]; do
    log "attempt: resolving slot $SLOT"
    local resolved state handle
    resolved="$("$SLOT_BIN" resolve "$SLOT" 2>>"$QDIR/$JOB_ID.log" || true)"
    state="$(printf '%s' "$resolved"  | python3 -c "import json,sys;
try:
  print(json.load(sys.stdin).get('state',''))
except Exception:
  print('')" 2>/dev/null)"
    handle="$(printf '%s' "$resolved" | python3 -c "import json,sys;
try:
  h=json.load(sys.stdin).get('identity_handle')
  print(h if isinstance(h,str) else '')
except Exception:
  print('')" 2>/dev/null)"

    if [ "$state" = "AVAILABLE" ] && [ -n "$handle" ]; then
      # One root task per subscription: refuse if this terminal already backs an active root task.
      local busy
      busy="$("$ORCA_BIN" orchestration worker-list --include-remote --json 2>/dev/null | python3 -c "
import json,sys
h='$handle'
try:
  d=json.load(sys.stdin); r=d.get('result',d)
  active={'ready','running','dispatched','working'}
  hit=any(w.get('agentTerminalHandle')==h and str(w.get('workerState','')).lower() in active for w in r.get('workers',[]))
  print('BUSY' if hit else 'FREE')
except Exception:
  print('FREE')" 2>/dev/null)"
      if [ "$busy" = "BUSY" ]; then
        log "slot AVAILABLE but terminal already backs an active root task; will retry"
      else
        log "dispatching to resolved handle (not persisted): worker-start --terminal <handle>"
        if "$ORCA_BIN" orchestration worker-start \
             --terminal "$handle" \
             --run "$RUN_ID" \
             --worktree "$WORKTREE_ID" \
             --spec "$(cat "$SPEC")" \
             --json >>"$QDIR/$JOB_ID.log" 2>&1; then
          log "DISPATCHED $JOB_ID to $SLOT"
          echo "dispatched $(date '+%F %T %Z')" > "$QDIR/$JOB_ID.done"
          exit 0
        else
          log "dispatch attempt failed (likely usage not reset); will retry"
        fi
      fi
    else
      log "slot state=$state (need AVAILABLE); will retry"
    fi
    sleep $(( RETRY_MIN * 60 ))
  done

  log "WINDOW EXPIRED without dispatch for $JOB_ID"
  echo "expired $(date '+%F %T %Z')" > "$QDIR/$JOB_ID.done"
  exit 1
}

sub="${1:-}"; shift || true
case "$sub" in
  add) cmd_add "$@";;
  list) cmd_list;;
  cancel) cmd_cancel "$@";;
  logs) cmd_logs "$@";;
  run) cmd_run "$@";;
  *)
    cat >&2 <<EOF
overnight-queue — simple overnight Codex worker queue (Orca stays the manager)
usage:
  scripts/overnight-queue add --slot <hamza|zk1|zk2> --run <run_id> --spec <file> \\
      --reset "YYYY-MM-DD HH:MM" [--buffer-min 60] [--retry-min 10] [--window-min 120]
  scripts/overnight-queue list
  scripts/overnight-queue cancel <job_id|all>
  scripts/overnight-queue logs <job_id>
EOF
    exit 64;;
esac
