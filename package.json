{
  "name": "career-sim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "check:product-contract": "node scripts/check-product-contract.mjs",
    "check:dev": "node scripts/check-dev.mjs",
    "dev": "node scripts/dev-banner.mjs && turbo dev",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:golden-path": "playwright test",
    "test:red": "vitest run --config vitest.red.config.ts",
    "test:packages": "turbo test",
    "test:unit": "vitest run",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  }
}
